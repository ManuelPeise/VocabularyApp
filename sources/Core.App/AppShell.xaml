<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="Core.App.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:public="clr-namespace:Core.App.Views.Public"
       xmlns:user="clr-namespace:Core.App.Views.Private.User"
       xmlns:shared="clr-namespace:Core.App.Views.Shared"
       Padding="0">

    <Shell.FlyoutHeader>
        <shared:FlyoutMenuHeader UserName="{Binding AuthResult.UserName}"
                                 LogoutCommand="{Binding HandleLogoutCommand}" />
    </Shell.FlyoutHeader>
    <FlyoutItem Title="Home"
                Route="HomePage"
                Shell.FlyoutBehavior="Flyout"
                Icon="home_icon.png">
        <ShellContent ContentTemplate="{DataTemplate user:HomePage}" />
    </FlyoutItem>


</Shell>
