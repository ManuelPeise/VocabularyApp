<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="Core.App.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:public="clr-namespace:Core.App.Views.Public"
       xmlns:user="clr-namespace:Core.App.Views.Private.User"
       xmlns:shared="clr-namespace:Core.App.Views.Shared"
       xmlns:settings="clr-namespace:Core.App.Views.Private.User.Settings"
       Padding="0">

    <Shell.FlyoutHeader>
        <!-- Bind to the current user's email exposed via PrivateViewModelBase.UserData -->
        <shared:FlyoutMenuHeader />
    </Shell.FlyoutHeader>
    <FlyoutItem Title="Home"
                Route="HomePage"
                Shell.FlyoutBehavior="Flyout"
                Icon="home_icon.png">
        <ShellContent ContentTemplate="{DataTemplate user:HomePage}" />
    </FlyoutItem>
    <FlyoutItem Title="Settings"
                Route="SettingsPage"
                Shell.FlyoutBehavior="Flyout"
                Icon="home_icon.png">
        <ShellContent ContentTemplate="{DataTemplate settings:SettingsPage}" />
    </FlyoutItem>


</Shell>
