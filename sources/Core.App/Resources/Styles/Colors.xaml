<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Backgrounds -->
    <Color x:Key="BackgroundColor">#121212</Color>
    <Color x:Key="CardDarkBackgroundColor">#1E1E1E</Color>
    <Color x:Key="CardLightBackgroundColor">#f2f2f2</Color>
    <Color x:Key="ButtonBackgroundColor">#232323</Color>
    <Color x:Key="EntryBackgroundColor">#232323</Color>

    <!-- Text -->
    <Color x:Key="PrimaryTextColor">#FFFFFF</Color>
    <Color x:Key="SecondaryTextColor">#B0B0B0</Color>
    <Color x:Key="DisabledTextColor">#666666</Color>
    <Color x:Key="TextOrange">#e67300</Color>
    
    <!-- Buttons -->
    <Color x:Key="ButtonTextColor">#FFFFFF</Color>
    <Color x:Key="ButtonBorderColor">#333333</Color>
    <Color x:Key="ButtonAccentColor">#2979FF</Color>

    <!-- Accents & Highlights -->
    <Color x:Key="AccentColor">#2979FF</Color>
    <Color x:Key="ErrorColor">#CF6679</Color>
    <Color x:Key="SuccessColor">#00C853</Color>
    <Color x:Key="WarningColor">#FFD600</Color>

    <!-- Divider & Border -->
    <Color x:Key="DividerColor">#333333</Color>
    <Color x:Key="BorderColor">#444444</Color>

</ResourceDictionary>