<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- GRID -->
    <Style x:Key="SettingeWrapper"
           TargetType="Grid">
        <Setter Property="Padding"
                Value="10" />
        <Setter Property="BackgroundColor"
                Value="{StaticResource CardLightBackgroundColor}" />
        <Setter Property="ColumnSpacing"
                Value="10" />
    </Style>
    
    <!-- TYPOGRAPHY -->
    <Style x:Key="TitleLabelStyle"
           TargetType="Label">
        <Setter Property="TextColor"
                Value="{StaticResource PrimaryTextColor}" />
        <Setter Property="FontAttributes"
                Value="Bold" />
        <Setter Property="FontSize"
                Value="{OnIdiom Phone=30, Tablet=20, Desktop=24}" />
        <Setter Property="Margin"
                Value="0,2,0,2" />
        <Setter Property="HorizontalOptions"
                Value="Center" />
        <Setter Property="VerticalOptions"
                Value="Center" />
        <Setter Property="CharacterSpacing"
                Value="2" />
    </Style>
    <Style x:Key="SubTitleLabelStyle"
           TargetType="Label">
        <Setter Property="TextColor"
                Value="{StaticResource SecondaryTextColor}" />
        <Setter Property="FontAttributes"
                Value="Italic" />
        <Setter Property="FontSize"
                Value="{OnIdiom Phone=20, Tablet=16, Desktop=20}" />
        <Setter Property="FontAttributes"
                Value="Bold" />
        <Setter Property="Margin"
                Value="0,2,0,2" />
        <Setter Property="HorizontalOptions"
                Value="Center" />
        <Setter Property="VerticalOptions"
                Value="Center" />
        <Setter Property="CharacterSpacing"
                Value="1" />
        <Setter Property="LineBreakMode"
                Value="WordWrap" />
    </Style>

    <Style x:Key="PageCaptionLabelStyle"
           TargetType="Label">
        <Setter Property="TextColor"
                Value="{StaticResource SecondaryTextColor}" />
        <Setter Property="FontAttributes"
                Value="Italic" />
        <Setter Property="FontSize"
                Value="{OnIdiom Phone=20, Tablet=16, Desktop=20}" />
        <Setter Property="FontAttributes"
                Value="None" />
        <Setter Property="FontFamily"
                Value="FASolid" />
        <Setter Property="Margin"
                Value="0,15" />
        <Setter Property="HorizontalOptions"
                Value="Center" />
        <Setter Property="VerticalOptions"
                Value="Center" />
        <Setter Property="CharacterSpacing"
                Value="2" />
        <Setter Property="LineBreakMode"
                Value="WordWrap" />
    </Style>

    <Style x:Key="CheckboxLabel"
           TargetType="Label">
        <Setter Property="FontSize"
                Value="{OnIdiom Phone=18, Tablet=16, Desktop=20}" />
        <Setter Property="CharacterSpacing"
                Value="1" />
        <Setter Property="LineBreakMode"
                Value="WordWrap" />
    </Style>
    <Style x:Key="SettingsTitleStyle"
           TargetType="Label">
        <Setter Property="TextColor"
                Value="{StaticResource DisabledTextColor}" />
        <Setter Property="FontAttributes"
                Value="Italic" />
        <Setter Property="FontSize"
                Value="{OnIdiom Phone=18, Tablet=16, Desktop=20}" />
        <Setter Property="Margin"
                Value="0" />
        <Setter Property="Padding"
                Value="5,2,0,2" />
        <Setter Property="HorizontalOptions"
                Value="Start" />
        <Setter Property="VerticalOptions"
                Value="Center" />
        <Setter Property="CharacterSpacing"
                Value="2" />
    </Style>
    <Style x:Key="SettingsLabelStyle"
           TargetType="Label">
        <Setter Property="TextColor"
                Value="{StaticResource SecondaryTextColor}" />
        <Setter Property="FontAttributes"
                Value="None" />
        <Setter Property="FontSize"
                Value="{OnIdiom Phone=16, Tablet=14, Desktop=18}" />
        <Setter Property="Margin"
                Value="0,2,0,2" />
        <Setter Property="HorizontalOptions"
                Value="Start" />
        <Setter Property="VerticalOptions"
                Value="Center" />
        <Setter Property="CharacterSpacing"
                Value="2" />
    </Style>
    <!-- BORDERS -->
    <Style x:Key="CardBorder"
           TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource CardLightBackgroundColor}" />
        <Setter Property="StrokeThickness"
                Value="1" />
        <Setter Property="StrokeShape"
                Value="RoundRectangle 10" />
        <Setter Property="BackgroundColor"
                Value="{StaticResource CardLightBackgroundColor}" />
        <Setter Property="Opacity"
                Value=".6" />
        <Setter Property="Margin"
                Value="10" />
        <Setter Property="Padding"
                Value="10,20" />
    </Style>

    <!-- Entries -->
    <Style x:Key="Entry"
           TargetType="Entry">
        <Setter Property="FontSize"
                Value="{OnIdiom Phone=18, Tablet=20, Desktop=22}" />
        <Setter Property="PlaceholderColor"
                Value="{StaticResource SecondaryTextColor}" />
        <Style.Triggers>
            <Trigger TargetType="Entry"
                     Property="IsEnabled"
                     Value="False">
                <Setter Property="TextColor"
                        Value="{StaticResource SecondaryTextColor}" />
                <Setter Property="Opacity"
                        Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- DatePicker -->
    <Style x:Key="DatePicker"
           TargetType="DatePicker">
        <Setter Property="FontSize"
                Value="{OnIdiom Phone=18, Tablet=20, Desktop=22}" />
    </Style>

    <!-- BUTTONS -->
    <Style x:Key="OutlinedTransparentButton"
           TargetType="Button">
        <Setter Property="BackgroundColor"
                Value="Transparent" />
        <Setter Property="FontSize"
                Value="{OnIdiom Phone=18, Tablet=20, Desktop=22}" />
        <Setter Property="TextColor"
                Value="{StaticResource ButtonTextColor}" />
        <Setter Property="BorderColor" 
                Value="{StaticResource ButtonTextColor}" />
        <Setter Property="CornerRadius"
                Value="{OnIdiom Phone=5, Tablet=5, Desktop=24}" />
        <Setter Property="HeightRequest"
                Value="{OnIdiom Phone=50, Tablet=50, Desktop=100}" />
        <Style.Triggers>
            <Trigger TargetType="Button"
                     Property="IsEnabled"
                     Value="False">
                <Setter Property="TextColor"
                        Value="{StaticResource SecondaryTextColor}" />
                <Setter Property="Opacity"
                        Value="0.6" />
                <Setter Property="BorderColor"
                        Value="{StaticResource SecondaryTextColor}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="OutlinedAccentButton"
           TargetType="Button">
        <Setter Property="BackgroundColor"
                Value="Transparent" />
        <Setter Property="FontSize"
                Value="{OnIdiom Phone=18, Tablet=20, Desktop=22}" />
        <Setter Property="TextColor"
                Value="{StaticResource AccentColor}" />
        <Setter Property="BorderColor"
                Value="{StaticResource AccentColor}" />
        <Setter Property="CornerRadius"
                Value="{OnIdiom Phone=5, Tablet=5, Desktop=24}" />
        <Setter Property="HeightRequest"
                Value="{OnIdiom Phone=40, Tablet=40, Desktop=100}" />
        <Style.Triggers>
            <Trigger TargetType="Button"
                     Property="IsEnabled"
                     Value="False">
                <Setter Property="TextColor"
                        Value="{StaticResource SecondaryTextColor}" />
                <Setter Property="Opacity"
                        Value="0.6" />
                <Setter Property="BorderColor"
                        Value="{StaticResource SecondaryTextColor}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
