<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Core.App.Views.Public.StartPage"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="200,Auto, Auto,*"
          ColumnDefinitions="*,*">
        <!-- Background Image -->
        <Image Source="waves.jpg"
               Opacity="0.8"
               Aspect="AspectFill"
               Grid.RowSpan="4"
               Grid.ColumnSpan="2" />

        <!-- Title -->
        <Label Grid.Row="0"
               Grid.ColumnSpan="2"
               Text="{Binding Localizer[CaptionAppTitle]}"
               Style="{StaticResource TitleLabelStyle}" />
        <!-- Description -->
        <Label Grid.Row="1"
               Grid.ColumnSpan="2"
               TextColor="{StaticResource TextOrange}"
               Text="{Binding Localizer[LabelPrimaryAppDescription]}"
               Style="{StaticResource SubTitleLabelStyle}" />

        <Label Grid.Row="2"
               Grid.ColumnSpan="2"
               TextColor="{StaticResource TextOrange}"
               Text="{Binding Localizer[LabelSecondaryAppDescription]}"
               Style="{StaticResource SubTitleLabelStyle}" />

        <!-- Button group aligned at bottom -->
        <Grid x:Name="buttonGroup"
              Grid.Row="3"
              Grid.ColumnSpan="2"
              ColumnDefinitions="*,*"
              Padding="16,8"
              Margin="0, 10"
              ColumnSpacing="10"
              VerticalOptions="End">

            <Button Grid.Column="0"
                    Style="{StaticResource OutlinedTransparentButton}"
                    Text="{Binding Localizer[LabelLogin]}"
                    Command="{Binding NavigateToLoginCommand}" />

            <Button Grid.Column="1"
                    Style="{StaticResource OutlinedTransparentButton}"
                    Text="{Binding Localizer[LabelCreateAccount]}"
                    Command="{Binding NavigateToRegisterCommand}" />
        </Grid>
    </Grid>
</ContentPage>