<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:shared="clr-namespace:Core.App.Views.Shared"
               x:Class="Core.App.Views.Private.User.Profile.ChangePasswordPopup"
               xmlns:local="clr-namespace:Core.App"
               xmlns:converters="clr-namespace:Core.App.Converters"
               Margin="10"
               MinimumWidthRequest="300"
               x:Name="changePasswordPopup">
    <Grid RowDefinitions="Auto, Auto, *, *, *, *"
          ColumnDefinitions="*, Auto"
          Padding="10"
          RowSpacing="25"
          ColumnSpacing="10">
        <Label Grid.Row="0"
               Grid.ColumnSpan="2"
               Margin="0,20"
               Style="{StaticResource SubTitleLabelStyle}"
               FontAttributes="Bold"
               Text="{Binding Localizer[LabelChangePassword]}" />
        <shared:LabeledEntry Grid.Row="1"
                             Grid.Column="0"
                             Grid.ColumnSpan="2"
                             Icon="{x:Static local:Icons.LockIcon}"
                             Label="{Binding Localizer[LabelCurrentPassword]}"
                             IsPassword="True"
                             Placeholder="{Binding Localizer[PlaceholderEnterCurrentPassword]}"
                             Text="{Binding Model.CurrentPassword}" />
        <shared:LabeledEntry Grid.Row="2"
                             Grid.Column="0"
                             Grid.ColumnSpan="2"
                             Icon="{x:Static local:Icons.LockIcon}"
                             Label="{Binding Localizer[LabelNewPassword]}"
                             IsPassword="True"
                             Placeholder="{Binding Localizer[PlaceholderEnterNewPassword]}"
                             Text="{Binding Model.NewPassword}"
                             IsEnabled="{Binding IsNewPasswordEnabled}"/>
        <shared:LabeledEntry Grid.Row="3"
                             Grid.Column="0"
                             Grid.ColumnSpan="2"
                             Label="{Binding Localizer[LabelPasswordConfirmation]}"
                             Icon="{x:Static local:Icons.LockIcon}"
                             IsPassword="True"
                             Placeholder="{Binding Localizer[PlaceholderEnterNewPassword]}"
                             Text="{Binding Model.PasswordReplication}"
                             IsEnabled="{Binding IsPasswordConfirmationEnabled}"/>
        <Label Grid.Row="4"
               Grid.Column="0"
               Grid.ColumnSpan="2"
               Margin="10"
               Text="{Binding Model.ErrorMessage}"
               TextColor="Red" />
        <!-- implement grid for save and cancel-->
        <Grid Grid.Row="5" Grid.ColumnSpan="2" ColumnDefinitions="*,*"
              ColumnSpacing="10">
            <Button Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource OutlinedAccentButton}"
                    Text="{Binding Localizer[LabelCancel]}"
                    TextTransform="Uppercase"
                    Command="{Binding ClosePopupCommand}"
                    CommandParameter="{x:Reference Name=changePasswordPopup}" />
            <Button Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource OutlinedAccentButton}"
                    Text="{Binding Localizer[LabelChange]}"
                    TextTransform="Uppercase"
                    Command="{Binding ChangePasswordCommand}"
                    CommandParameter="{x:Reference Name=changePasswordPopup}"
                    IsEnabled="{Binding CanChangePassword}"/>
        </Grid>
        
    </Grid>
</toolkit:Popup>

