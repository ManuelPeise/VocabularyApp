<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Core.App.Views.Private.User.Profile.UserProfilePage"
             xmlns:shared="clr-namespace:Core.App.Views.Shared"
             xmlns:views="clr-namespace:Core.App.Views.Private.User.Profile"
             xmlns:resx="clr-namespace:Resx;assembly=Shared.Resources"
             xmlns:converters="clr-namespace:Core.App.Converters"
             Padding="0"
             Shell.NavBarIsVisible="True"
             NavigationPage.HasBackButton="True">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:ByteArrayToImageSourceConverter x:Key="byteArrayToImageSourceConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,*">
        <views:ProfileHeaderView Grid.Row="0"
                                 UserName="{Binding UserName}"
                                 ProfileImage="{Binding UserProfileModel.ProfileImage, Converter={StaticResource byteArrayToImageSourceConverter}}"
                                 ChangeImageCommand="{Binding HandleUpdateProfileImageCommand}" />
        <Grid Grid.Row="1">
            <VerticalStackLayout Padding="0,10">
                <Label Style="{StaticResource PageCaptionLabelStyle}"
                       Text="{x:Static resx:Core.CaptionYourProfileData}" />
                <BoxView HeightRequest="1"
                         Margin="15,10"
                         BackgroundColor="{StaticResource DividerSecondaryColor}" />
                <shared:LabeledEntry IsEnabled="True"
                                     Margin="10,5"
                                     Text="{Binding UserProfileModel.FirstName}"
                                     Icon="&#xf007;"
                                     Label="{x:Static resx:Core.LabelFirstName}"
                                     Placeholder="{x:Static resx:Core.PlaceholderEnterFirstName}" />
                <shared:LabeledEntry IsEnabled="True"
                                     Margin="10, 5"
                                     Text="{Binding UserProfileModel.LastName}"
                                     Icon="&#xf007;"
                                     Label="{x:Static resx:Core.LabelLastName}"
                                     Placeholder="{x:Static resx:Core.PlaceholderEnterLastName}" />
                <shared:LabeledEntry IsEnabled="False"
                                     Margin="10,5"
                                     Text="{Binding UserProfileModel.UserName}"
                                     Icon="&#xf007;"
                                     Label="{x:Static resx:Core.LabelUsername}"
                                     Placeholder="{x:Static resx:Core.PlaceholderEnterUserName}" />
                <shared:LabeledDatePicker IsEnabled="True"
                                          Margin="10,5"
                                          Label="{x:Static resx:Core.LabelDateOfBirth}"
                                          Icon="&#xf133;"
                                          Date="{Binding UserProfileModel.DateOfBirth}" />
                <Grid ColumnDefinitions="30, *"
                      Margin="10,10">
                    <Label Grid.Column="0"
                           Text="&#xf021;"
                           FontFamily="FASolid"
                           FontSize="20"
                           FontAttributes="Bold"
                           Margin="5,0,5,12"
                           HorizontalOptions="End"
                           VerticalOptions="End"
                           IsVisible="True"/>
                    <Button Grid.Column="1"
                            Style="{StaticResource OutlinedAccentButton}"
                            HorizontalOptions="End"
                            Text="{x:Static resx:Core.LabelChangePassword}"
                            TextTransform="Uppercase"
                            Margin="5,0"
                            FontSize="16"
                            Command="{Binding ShowChangePasswordPopupCommand}"/>

                </Grid>
               
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="5"
                      Margin="10,15">
                    <Button Grid.Column="0"
                            Style="{StaticResource OutlinedAccentButton}"
                            BackgroundColor="{StaticResource AccentColor}"
                            TextColor="#ffffff"
                            IsEnabled="{Binding IsModified}"
                            IsVisible="{Binding IsModified}"
                            Text="{x:Static resx:Core.LabelCancel}"
                            Command="{Binding RevertChangesCommand}"/>
                    <Button Grid.Column="1"
                            Style="{StaticResource OutlinedAccentButton}"
                            BackgroundColor="{StaticResource AccentColor}"
                            TextColor="#ffffff"
                            IsEnabled="{Binding IsModified}"
                            IsVisible="{Binding IsModified}"
                            Text="{x:Static resx:Core.LabelSave}"
                            Command="{Binding SaveChangesCommand}"/>
                </Grid>

            </VerticalStackLayout>
        </Grid>
        <shared:LoadingOverlay IsLoading="{Binding IsBusy}"
                               Grid.Row="0"
                               Grid.RowSpan="2"
                               Grid.Column="0" />
    </Grid>
</ContentPage>
