<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Core.App.Views.Private.User.Settings.SettingsWrapper"
             x:Name="root">
    <Grid ColumnDefinitions="*, Auto" Style="{StaticResource SettingeWrapper}">
        <Label Grid.Column="0"
               Text="{Binding Title, Source={x:Reference root}}"
               Style="{StaticResource SettingsLabelStyle}" />
        <ContentPresenter Grid.Column="1"
                          Content="{Binding Source={x:Reference root}, Path=SettingContent}"
                          HorizontalOptions="End"
                          VerticalOptions="End" />
    </Grid>
</ContentView>
