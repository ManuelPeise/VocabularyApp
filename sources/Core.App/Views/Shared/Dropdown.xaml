<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Core.App.Views.Shared.Dropdown"
             x:Name="root">
    <Picker ItemsSource="{Binding Source={x:Reference root}, Path=Items}"
            SelectedItem="{Binding Source={x:Reference root}, Path=SelectedItem, Mode=TwoWay}"
            ItemDisplayBinding="{Binding Label}"
            BackgroundColor="{Binding Source={x:Reference root}, Path=BackgroundColor, FallbackValue={StaticResource EntryBackgroundColor}}"
            TextColor="{Binding Source={x:Reference root}, Path=TextColor, FallbackValue={StaticResource PrimaryTextColor}}"
            WidthRequest="150"
            HorizontalOptions="End"
            VerticalOptions="Center" />
</ContentView>
