<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Core.App.Views.Shared.Switch"
             x:Name="root"
             WidthRequest="51"
             HeightRequest="31">
    <Switch IsToggled="{Binding Source={x:Reference root}, Path=IsToggled, Mode=TwoWay}"
            OnColor="{Binding Source={x:Reference root}, Path=OnColor, FallbackValue={StaticResource AccentColor}}"
            ThumbColor="{Binding Source={x:Reference root}, Path=ThumbColor}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />
</ContentView>
