## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
logs/

# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/

# Visual Studio for Mac
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Rider
.idea/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Publish outputs
publish/
out/

# Resharper
_ReSharper*/
*.DotSettings.user

# DotCover
*.dotCover

# Backup & reports
*.ncrunch*
*.localhistory/
*.orig
*.cache
*.vspscc
*.vssscc

# Others
*.log
*.vs/
.vscode/
.vsconfig
*.dbmdl
*.dbml
*.bak
*.sql

# Secrets
appsettings.Development.json
secrets.json

# Environment
.env
